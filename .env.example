# Copy to .env and fill in — docker compose reads .env automatically.

# GitHub personal access token used by `gh`/`git` inside the container so
# clone-repo, list-repos, and Claude Code's own git commands work against
# repos you have access to without any further login step.
#
# Create one at https://github.com/settings/tokens (fine-grained, scoped to
# the repos you want, with Contents read/write) or a classic token with the
# `repo` scope. Leave blank to skip — public repos over https still work.
GH_TOKEN=

# Password for the browser-based terminal at http://localhost:7681, AND
# for the web dashboard at http://localhost:8811 (it can clone repos and
# start/stop sessions, not just view them, so it needs the same gate).
# Just a password — NOT "username:password". The username is always
# 'dev' and isn't set here or anywhere else; the browser's basic-auth
# prompt asks for both, so type 'dev' in the username field and this
# value in the password field.
#
# The terminal is a full interactive shell as 'dev' — the same access
# any Claude Code session already has, including sudo apt-get and
# whatever GH_TOKEN grants. Leave blank to disable the terminal AND
# leave the dashboard unauthenticated (its own note explains why that's
# worth thinking about); `docker exec -it claude-dev sudo -u dev bash`
# always works either way.
#
# Letters, digits, '-' and '_' only — it's embedded directly in a
# generated supervisord config, and other characters (quotes, ';', '%')
# can break that file's parsing.
#
# Upgrading from an older version? This was called TTYD_TOKEN before it
# also started gating the dashboard, not just the terminal -- the old
# name still works (with a warning) but rename it here when convenient.
WEB_TOKEN=

