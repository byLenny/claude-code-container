# Copy to .env and fill in — docker compose reads .env automatically.

# GitHub personal access token used by `gh`/`git` inside the container so
# clone-repo, list-repos, and Claude Code's own git commands work against
# repos you have access to without any further login step.
#
# Create one at https://github.com/settings/tokens (fine-grained, scoped to
# the repos you want, with Contents read/write) or a classic token with the
# `repo` scope. Leave blank to skip — public repos over https still work.
GH_TOKEN=
